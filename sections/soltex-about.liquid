<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web/src/regular/style.css" />

<style>
  .shopdev {
    --bg: {{ section.settings.background_color | default: '#FFFFFF' }};
    --fg: {{ section.settings.text_color | default: '#0D1B2A' }};
    --muted: #7D8A94;
    --card-bg: #FFFFFF;
    --card-bd: #E5E7EB;
    --shadow: rgba(13, 27, 42, 0.08);
    --radius: 12px;
    --navy: #0D1B2A;
    --accent: #7D8A94;
  }

  .shopdev[data-tone="dark"] {
    --bg: #0D1B2A;
    --fg: #FFFFFF;
    --card-bg: #1a2a3a;
    --card-bd: #2a3a4a;
    --shadow: rgba(0, 0, 0, 0.3);
  }

  .shopdev .soltex-about-wrapper {
    position: relative;
    background-color: var(--bg);
    color: var(--fg);
    overflow: hidden;
  }

  .shopdev .soltex-about-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .shopdev .soltex-about-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg);
    mix-blend-mode: multiply;
    z-index: 1;
  }

  .shopdev .soltex-about-content {
    position: relative;
    z-index: 2;
    padding: 64px 24px;
  }

  .shopdev .soltex-container {
    max-width: {{ section.settings.container_max }}px;
    margin: 0 auto;
  }

  .shopdev .soltex-section-title {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
    color: var(--fg);
  }

  .shopdev .soltex-section-subtitle {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 48px;
  }

  /* KPI Stats */
  .shopdev .soltex-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    margin-bottom: 80px;
  }

  .shopdev .soltex-kpi-item {
    text-align: center;
    padding: 32px 16px;
    background: var(--card-bg);
    border: 1px solid var(--card-bd);
    border-radius: var(--radius);
    box-shadow: 0 2px 8px var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .shopdev .soltex-kpi-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px var(--shadow);
  }

  .shopdev .soltex-kpi-number {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 8px;
  }

  .shopdev[data-tone="dark"] .soltex-kpi-number {
    color: var(--fg);
  }

  .shopdev .soltex-kpi-label {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
  }

  /* Mission/Vision */
  .shopdev .soltex-mission-vision {
    margin-bottom: 80px;
  }

  .shopdev .soltex-mv-block {
    margin-bottom: 48px;
  }

  .shopdev .soltex-mv-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--fg);
  }

  .shopdev .soltex-mv-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg);
  }

  /* Values */
  .shopdev .soltex-values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin-bottom: 80px;
  }

  .shopdev .soltex-value-card {
    padding: 32px;
    background: var(--card-bg);
    border: 1px solid var(--card-bd);
    border-radius: var(--radius);
    box-shadow: 0 2px 8px var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .shopdev .soltex-value-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px var(--shadow);
  }

  .shopdev .soltex-value-icon {
    font-size: 48px;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .shopdev .soltex-value-title {
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--fg);
  }

  .shopdev .soltex-value-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Timeline */
  .shopdev .soltex-timeline {
    margin-bottom: 80px;
  }

  .shopdev .soltex-timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--card-bd);
  }

  .shopdev .soltex-timeline-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  @media (min-width: 768px) {
    .shopdev .soltex-timeline-item {
      grid-template-columns: 2fr 1fr;
    }
  }

  .shopdev .soltex-timeline-content {
    order: 1;
  }

  .shopdev .soltex-timeline-year {
    font-family: 'Poppins', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 12px;
  }

  .shopdev .soltex-timeline-title {
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--fg);
  }

  .shopdev .soltex-timeline-text {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .shopdev .soltex-timeline-image {
    order: 2;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .shopdev .soltex-timeline-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 200px;
  }

  /* Team */
  .shopdev .soltex-team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-bottom: 80px;
  }

  .shopdev .soltex-team-card {
    text-align: center;
    padding: 32px;
    background: var(--card-bg);
    border: 1px solid var(--card-bd);
    border-radius: var(--radius);
    box-shadow: 0 2px 8px var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .shopdev .soltex-team-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px var(--shadow);
  }

  .shopdev .soltex-team-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto 16px;
    overflow: hidden;
    background: var(--card-bd);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shopdev .soltex-team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shopdev .soltex-team-placeholder {
    font-family: 'Poppins', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: var(--accent);
  }

  .shopdev .soltex-team-name {
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--fg);
  }

  .shopdev .soltex-team-role {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .shopdev .soltex-team-bio {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* CTA */
  .shopdev .soltex-cta-wrapper {
    text-align: {{ section.settings.content_align }};
  }

  .shopdev .soltex-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .shopdev .soltex-cta-button.solid {
    background: var(--navy);
    color: #FFFFFF;
    border: 2px solid var(--navy);
  }

  .shopdev .soltex-cta-button.solid:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .shopdev .soltex-cta-button.outline {
    background: transparent;
    color: var(--fg);
    border: 2px solid var(--fg);
  }

  .shopdev .soltex-cta-button.outline:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .shopdev .soltex-cta-button i {
    font-size: 20px;
  }

  /* Animations */
  @keyframes shopdev-fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shopdev .fade-in-up {
    opacity: 0;
    animation: shopdev-fadeInUp 0.8s ease-out forwards;
  }

  /* Accessibility */
  .shopdev *:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .shopdev .soltex-about-content {
      padding: 48px 16px;
    }

    .shopdev .soltex-kpi-grid,
    .shopdev .soltex-values-grid,
    .shopdev .soltex-team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="w-full">
  <div class="soltex-about-wrapper" data-tone="{{ section.settings.tone }}">
    {% if section.settings.background_style == 'image' and section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: 
        loading: 'lazy',
        class: 'soltex-about-bg-image',
        alt: section.settings.background_image.alt | default: 'Background'
      }}
      <div class="soltex-about-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
    {% endif %}

    <div class="soltex-about-content">
      <div class="soltex-container">
        
        <!-- KPI Stats -->
        {% assign kpi_blocks = section.blocks | where: "type", "kpi" %}
        {% if kpi_blocks.size > 0 %}
          <div class="soltex-kpi-grid fade-in-up" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
            {% for block in kpi_blocks %}
              <div class="soltex-kpi-item" data-count="{{ block.settings.number }}" {{ block.shopify_attributes }}>
                <div class="soltex-kpi-number" data-target="{{ block.settings.number }}">0</div>
                <div class="soltex-kpi-label">{{ block.settings.label }}</div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Mission/Vision -->
        {% assign mv_blocks = section.blocks | where: "type", "mission_vision" %}
        {% if mv_blocks.size > 0 %}
          <div class="soltex-mission-vision">
            {% for block in mv_blocks %}
              <div class="soltex-mv-block fade-in-up" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h2 class="soltex-mv-title">{{ block.settings.title }}</h2>
                {% endif %}
                {% if block.settings.content != blank %}
                  <div class="soltex-mv-text">{{ block.settings.content }}</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Values -->
        {% assign value_blocks = section.blocks | where: "type", "value" %}
        {% if value_blocks.size > 0 %}
          <div class="soltex-values-grid fade-in-up">
            {% for block in value_blocks %}
              <div class="soltex-value-card" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <i class="ph {{ block.settings.icon }} soltex-value-icon"></i>
                {% endif %}
                {% if block.settings.title != blank %}
                  <h3 class="soltex-value-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="soltex-value-desc">{{ block.settings.description }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Timeline -->
        {% assign timeline_blocks = section.blocks | where: "type", "timeline" %}
        {% if timeline_blocks.size > 0 %}
          <div class="soltex-timeline">
            {% for block in timeline_blocks %}
              <div class="soltex-timeline-item fade-in-up" {{ block.shopify_attributes }}>
                <div class="soltex-timeline-content">
                  {% if block.settings.year != blank %}
                    <div class="soltex-timeline-year">{{ block.settings.year }}</div>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <h3 class="soltex-timeline-title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="soltex-timeline-text">{{ block.settings.text }}</p>
                  {% endif %}
                </div>
                {% if block.settings.image != blank %}
                  <div class="soltex-timeline-image">
                    {{ block.settings.image | image_url: width: 600 | image_tag: 
                      loading: 'lazy',
                      alt: block.settings.image.alt | default: block.settings.title
                    }}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Team -->
        {% assign team_blocks = section.blocks | where: "type", "team" %}
        {% if team_blocks.size > 0 %}
          <div class="soltex-team-grid fade-in-up">
            {% for block in team_blocks %}
              <div class="soltex-team-card" {{ block.shopify_attributes }}>
                <div class="soltex-team-photo">
                  {% if block.settings.photo != blank %}
                    {{ block.settings.photo | image_url: width: 240 | image_tag: 
                      loading: 'lazy',
                      alt: block.settings.name | default: 'Team member'
                    }}
                  {% else %}
                    {% assign initials = block.settings.name | split: ' ' | map: 'first' | join: '' | upcase %}
                    <div class="soltex-team-placeholder">{{ initials | slice: 0, 2 }}</div>
                  {% endif %}
                </div>
                {% if block.settings.name != blank %}
                  <h3 class="soltex-team-name">{{ block.settings.name }}</h3>
                {% endif %}
                {% if block.settings.role != blank %}
                  <p class="soltex-team-role">{{ block.settings.role }}</p>
                {% endif %}
                {% if block.settings.bio != blank %}
                  <p class="soltex-team-bio">{{ block.settings.bio }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- CTA -->
        {% assign cta_blocks = section.blocks | where: "type", "cta" %}
        {% if cta_blocks.size > 0 %}
          <div class="soltex-cta-wrapper fade-in-up">
            {% for block in cta_blocks %}
              {% if block.settings.button_text != blank %}
                {% if block.settings.whatsapp_enabled and block.settings.whatsapp_number != blank %}
                  {% assign whatsapp_message = block.settings.whatsapp_message | url_encode %}
                  {% assign whatsapp_url = 'https://wa.me/' | append: block.settings.whatsapp_number | append: '?text=' | append: whatsapp_message %}
                  <a href="{{ whatsapp_url }}" 
                     class="soltex-cta-button {{ block.settings.button_style }}" 
                     target="_blank" 
                     rel="noopener noreferrer"
                     aria-label="Contact us on WhatsApp"
                     {{ block.shopify_attributes }}>
                    <i class="ph-whatsapp-logo"></i>
                    {{ block.settings.button_text }}
                  </a>
                {% elsif block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}" 
                     class="soltex-cta-button {{ block.settings.button_style }}"
                     {{ block.shopify_attributes }}>
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  // Intersection Observer for fade-in animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animationPlayState = 'running';
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.shopdev .fade-in-up').forEach(el => {
    el.style.animationPlayState = 'paused';
    observer.observe(el);
  });

  // Count-up animation for KPIs
  function animateCount(element) {
    const target = parseInt(element.dataset.target);
    const duration = 2000;
    const increment = target / (duration / 16);
    let current = 0;

    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        element.textContent = target.toLocaleString();
        clearInterval(timer);
      } else {
        element.textContent = Math.floor(current).toLocaleString();
      }
    }, 16);
  }

  const kpiObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const numberEl = entry.target.querySelector('.soltex-kpi-number');
        if (numberEl && !numberEl.dataset.animated) {
          numberEl.dataset.animated = 'true';
          animateCount(numberEl);
        }
        kpiObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.shopdev .soltex-kpi-item').forEach(el => {
    kpiObserver.observe(el);
  });

})();
</script>

{% schema %}
{
  "name": "soltex-about",
  "class": "shopdev",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Color Tone",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background Style",
      "options": [
        {
          "value": "solid",
          "label": "Solid Color"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0D1B2A"
