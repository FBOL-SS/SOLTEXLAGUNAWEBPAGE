<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web/src/regular/style.css" />

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap');

  .shopdev .soltex-market-grid {
    font-family: 'Inter', sans-serif;
  }

  .shopdev .soltex-market-grid h1,
  .shopdev .soltex-market-grid h2,
  .shopdev .soltex-market-grid h3 {
    font-family: 'Poppins', sans-serif;
  }

  .shopdev .filter-tag {
    transition: all 0.2s ease;
  }

  .shopdev .filter-tag:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .shopdev .product-card {
    transition: all 0.3s ease;
    border: 1px solid #E5E7EB;
  }

  .shopdev .product-card:hover {
    box-shadow: 0 8px 16px rgba(13, 27, 42, 0.12);
    transform: translateY(-4px);
  }

  .shopdev .product-card img {
    transition: transform 0.3s ease;
  }

  .shopdev .product-card:hover img {
    transform: scale(1.05);
  }

  .shopdev .quick-view-btn,
  .shopdev .quick-add-btn {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .shopdev .product-card:hover .quick-view-btn,
  .shopdev .product-card:hover .quick-add-btn {
    opacity: 1;
  }

  .shopdev .modal-overlay {
    backdrop-filter: blur(4px);
  }

  .shopdev .modal-content {
    animation: shopdev-modalSlideIn 0.3s ease-out;
  }

  @keyframes shopdev-modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shopdev .toast {
    animation: shopdev-toastSlideIn 0.3s ease-out;
  }

  @keyframes shopdev-toastSlideIn {
    from {
      opacity: 0;
      transform: translateX(100%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .shopdev .loading-spinner {
    border: 3px solid #E5E7EB;
    border-top-color: #0D1B2A;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: shopdev-spin 0.8s linear infinite;
  }

  @keyframes shopdev-spin {
    to { transform: rotate(360deg); }
  }

  .shopdev .filter-checkbox:checked + label {
    background-color: #0D1B2A;
    color: #FFFFFF;
  }

  .shopdev .price-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    background: #0D1B2A;
    cursor: pointer;
    border-radius: 50%;
  }

  .shopdev .price-range-input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    background: #0D1B2A;
    cursor: pointer;
    border-radius: 50%;
    border: none;
  }

  @media (max-width: 768px) {
    .shopdev .filters-sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }

    .shopdev .filters-sidebar.active {
      transform: translateX(0);
    }
  }
</style>

{% comment %} Pre-render product data from collection {% endcomment %}
<script id="products-data" type="application/json">
{
  "products": [
    {% if section.settings.collection != blank %}
      {% assign target_collection = collections[section.settings.collection] %}
    {% else %}
      {% assign target_collection = collections.all %}
    {% endif %}
    
    {% for product in target_collection.products limit: 250 %}
      {
        "id": {{ product.id | json }},
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json }},
        "vendor": {{ product.vendor | json }},
        "type": {{ product.type | json }},
        "price": {{ product.price | json }},
        "compareAtPrice": {% if product.compare_at_price > product.price %}{{ product.compare_at_price | json }}{% else %}null{% endif %},
        "available": {{ product.available | json }},
        "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
        "url": {{ product.url | json }},
        "variants": [
          {% for variant in product.variants %}
            {
              "id": {{ variant.id | json }},
              "title": {{ variant.title | json }},
              "price": {{ variant.price | json }},
              "available": {{ variant.available | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

<div class="w-full soltex-market-grid" style="background-color: #FFFFFF;">
  <div class="max-w-[1400px] mx-auto px-4 py-8 md:py-12">
    
    <!-- Header Section -->
    <div class="text-center mb-8 md:mb-12">
      {% if section.settings.heading != blank %}
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4" style="color: #0D1B2A;">
          {{ section.settings.heading }}
        </h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="text-base md:text-lg" style="color: #7D8A94;">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Active Filters Display -->
    <div id="active-filters" class="mb-6 hidden">
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm font-medium" style="color: #0D1B2A;">Active Filters:</span>
        <div id="filter-tags" class="flex flex-wrap gap-2"></div>
        <button id="clear-all-filters" class="text-sm font-medium hover:underline" style="color: #0D1B2A;">
          Clear All
        </button>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      
      <!-- Mobile Filter Toggle -->
      <div class="lg:hidden mb-4">
        <button id="mobile-filter-toggle" class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg font-medium" style="background-color: #0D1B2A; color: #FFFFFF;">
          <i class="ph ph-funnel"></i>
          <span>Filters & Sort</span>
        </button>
      </div>

      <!-- Filters Sidebar -->
      <aside id="filters-sidebar" class="filters-sidebar lg:w-64 flex-shrink-0 fixed lg:static top-0 left-0 h-full lg:h-auto w-80 lg:w-64 bg-white lg:bg-transparent z-50 lg:z-auto overflow-y-auto lg:overflow-visible p-6 lg:p-0 shadow-xl lg:shadow-none">
        
        <!-- Mobile Close Button -->
        <div class="lg:hidden flex justify-between items-center mb-6">
          <h3 class="text-xl font-bold" style="color: #0D1B2A;">Filters</h3>
          <button id="close-filters" class="p-2">
            <i class="ph ph-x text-2xl" style="color: #0D1B2A;"></i>
          </button>
        </div>

        <!-- Sort By -->
        <div class="mb-6 pb-6 border-b" style="border-color: #E5E7EB;">
          <h3 class="text-sm font-semibold mb-3 uppercase tracking-wide" style="color: #0D1B2A;">Sort By</h3>
          <select id="sort-select" class="w-full px-3 py-2 rounded-lg border" style="border-color: #E5E7EB; color: #0D1B2A;">
            <option value="">Relevance</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="created-descending">Newest First</option>
            <option value="title-ascending">Name: A-Z</option>
            <option value="title-descending">Name: Z-A</option>
          </select>
        </div>

        <!-- Availability Filter -->
        {% if section.settings.show_availability_filter %}
        <div class="mb-6 pb-6 border-b" style="border-color: #E5E7EB;">
          <h3 class="text-sm font-semibold mb-3 uppercase tracking-wide" style="color: #0D1B2A;">Availability</h3>
          <div class="space-y-2">
            <label class="flex items-center cursor-pointer">
              <input type="checkbox" class="filter-checkbox hidden" name="availability" value="in-stock">
              <span class="flex items-center gap-2 px-3 py-2 rounded-lg border transition-all" style="border-color: #E5E7EB; color: #0D1B2A;">
                <i class="ph ph-check-circle"></i>
                <span class="text-sm">In Stock</span>
              </span>
            </label>
            <label class="flex items-center cursor-pointer">
              <input type="checkbox" class="filter-checkbox hidden" name="availability" value="out-of-stock">
              <span class="flex items-center gap-2 px-3 py-2 rounded-lg border transition-all" style="border-color: #E5E7EB; color: #0D1B2A;">
                <i class="ph ph-x-circle"></i>
                <span class="text-sm">Out of Stock</span>
              </span>
            </label>
          </div>
        </div>
        {% endif %}

        <!-- Price Range Filter -->
        {% if section.settings.show_price_filter %}
        <div class="mb-6 pb-6 border-b" style="border-color: #E5E7EB;">
          <h3 class="text-sm font-semibold mb-3 uppercase tracking-wide" style="color: #0D1B2A;">Price Range</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <input type="number" id="price-min" placeholder="Min" class="w-full px-3 py-2 rounded-lg border text-sm" style="border-color: #E5E7EB; color: #0D1B2A;">
              <span style="color: #7D8A94;">-</span>
              <input type="number" id="price-max" placeholder="Max" class="w-full px-3 py-2 rounded-lg border text-sm" style="border-color: #E5E7EB; color: #0D1B2A;">
            </div>
            <button id="apply-price-filter" class="w-full px-4 py-2 rounded-lg text-sm font-medium" style="background-color: #0D1B2A; color: #FFFFFF;">
              Apply
            </button>
          </div>
        </div>
        {% endif %}

        <!-- Brand Filter -->
        {% if section.settings.show_brand_filter %}
        <div class="mb-6 pb-6 border-b" style="border-color: #E5E7EB;">
          <h3 class="text-sm font-semibold mb-3 uppercase tracking-wide" style="color: #0D1B2A;">Brand</h3>
          <div id="brand-filters" class="space-y-2 max-h-48 overflow-y-auto">
            <!-- Populated dynamically -->
          </div>
        </div>
        {% endif %}

        <!-- Product Type Filter -->
        {% if section.settings.show_type_filter %}
        <div class="mb-6 pb-6 border-b" style="border-color: #E5E7EB;">
          <h3 class="text-sm font-semibold mb-3 uppercase tracking-wide" style="color: #0D1B2A;">Product Type</h3>
          <div id="type-filters" class="space-y-2 max-h-48 overflow-y-auto">
            <!-- Populated dynamically -->
          </div>
        </div>
        {% endif %}

      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 min-w-0">
        
        <!-- Results Count & View Toggle -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
          <p id="results-count" class="text-sm" style="color: #7D8A94;">
            Loading products...
          </p>
        </div>

        <!-- Products Grid -->
        <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 mb-8">
          <!-- Products loaded here -->
        </div>

        <!-- Loading Indicator -->
        <div id="loading-indicator" class="hidden flex justify-center items-center py-12">
          <div class="loading-spinner"></div>
        </div>

        <!-- Load More Button -->
        {% if section.settings.enable_infinite_scroll == false %}
        <div id="load-more-container" class="hidden text-center">
          <button id="load-more-btn" class="px-8 py-3 rounded-lg font-medium transition-all hover:opacity-90" style="background-color: #0D1B2A; color: #FFFFFF;">
            Load More Products
          </button>
        </div>
        {% endif %}

        <!-- No Results Message -->
        <div id="no-results" class="hidden text-center py-12">
          <i class="ph ph-magnifying-glass text-6xl mb-4" style="color: #E5E7EB;"></i>
          <h3 class="text-xl font-semibold mb-2" style="color: #0D1B2A;">No products found</h3>
          <p class="text-sm mb-4" style="color: #7D8A94;">Try adjusting your filters or search criteria</p>
          <button id="reset-filters-btn" class="px-6 py-2 rounded-lg font-medium" style="background-color: #0D1B2A; color: #FFFFFF;">
            Reset Filters
          </button>
        </div>

      </main>
    </div>
  </div>
</div>

<!-- Quick View Modal -->
{% if section.settings.enable_quick_view %}
<div id="quick-view-modal" class="modal-overlay fixed inset-0 bg-black/50 z-[100] hidden items-center justify-center p-4">
  <div class="modal-content bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
    <div class="sticky top-0 bg-white z-10 flex justify-between items-center p-4 border-b" style="border-color: #E5E7EB;">
      <h3 class="text-xl font-bold" style="color: #0D1B2A;">Quick View</h3>
      <button id="close-modal" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
        <i class="ph ph-x text-2xl" style="color: #0D1B2A;"></i>
      </button>
    </div>
    <div id="modal-content" class="p-6">
      <!-- Product details loaded here -->
    </div>
  </div>
</div>
{% endif %}

<!-- Toast Notifications -->
<div id="toast-container" class="fixed top-4 right-4 z-[110] space-y-2">
  <!-- Toasts appear here -->
</div>

<script>
class SoltexMarketGrid {
  constructor() {
    this.collection = '{{ section.settings.collection }}' !== '' ? '{{ section.settings.collection }}' : 'all';
    this.productsPerPage = {{ section.settings.products_per_page }};
    this.enableInfiniteScroll = {{ section.settings.enable_infinite_scroll }};
    this.enableQuickView = {{ section.settings.enable_quick_view }};
    this.enableQuickAdd = {{ section.settings.enable_quick_add }};
    
    this.currentPage = 1;
    this.isLoading = false;
    this.hasMoreProducts = true;
    this.allProducts = [];
    this.filteredProducts = [];
    
    this.filters = {
      sort: '',
      availability: [],
      priceMin: null,
      priceMax: null,
      brands: [],
      types: []
    };

    this.init();
  }

  init() {
    this.loadProducts();
    this.setupEventListeners();
    this.setupInfiniteScroll();
    this.loadFiltersFromURL();
  }

  loadProducts() {
    this.isLoading = true;
    this.showLoading();

    try {
      // Load products from pre-rendered JSON data
      const productsDataElement = document.getElementById('products-data');
      if (productsDataElement) {
        const data = JSON.parse(productsDataElement.textContent);
        this.allProducts = data.products || [];
      } else {
        this.allProducts = [];
      }

      this.applyFilters();
      this.populateFilterOptions();
      
    } catch (error) {
      console.error('Error loading products:', error);
      this.showError();
    } finally {
      this.isLoading = false;
      this.hideLoading();
    }
  }

  applyFilters() {
    let filtered = [...this.allProducts];

    // Availability filter
    if (this.filters.availability.length > 0) {
      filtered = filtered.filter(p => {
        if (this.filters.availability.includes('in-stock') && p.available) return true;
        if (this.filters.availability.includes('out-of-stock') && !p.available) return true;
        return false;
      });
    }

    // Price filter
    if (this.filters.priceMin !== null) {
      filtered = filtered.filter(p => p.price >= this.filters.priceMin * 100);
    }
    if (this.filters.priceMax !== null) {
      filtered = filtered.filter(p => p.price <= this.filters.priceMax * 100);
    }

    // Brand filter
    if (this.filters.brands.length > 0) {
      filtered = filtered.filter(p => this.filters.brands.includes(p.vendor));
    }

    // Type filter
    if (this.filters.types.length > 0) {
      filtered = filtered.filter(p => this.filters.types.includes(p.type));
    }

    // Sort
    filtered = this.sortProducts(filtered);

    this.filteredProducts = filtered;
    this.currentPage = 1;
    this.renderProducts();
    this.updateResultsCount();
    this.updateActiveFilters();
    this.updateURL();
  }

  sortProducts(products) {
    const sorted = [...products];
    
    switch(this.filters.sort) {
      case 'price-ascending':
        return sorted.sort((a, b) => a.price - b.price);
      case 'price-descending':
        return sorted.sort((a, b) => b.price - a.price);
      case 'title-ascending':
        return sorted.sort((a, b) => a.title.localeCompare(b.title));
      case 'title-descending':
        return sorted.sort((a, b) => b.title.localeCompare(a.title));
      case 'created-descending':
        return sorted.reverse();
      default:
        return sorted;
    }
  }

  renderProducts(append = false) {
    const grid = document.getElementById('products-grid');
    const startIndex = append ? (this.currentPage - 1) * this.productsPerPage : 0;
    const endIndex = this.currentPage * this.productsPerPage;
    const productsToRender = this.filteredProducts.slice(startIndex, endIndex);

    if (!append) {
      grid.innerHTML = '';
    }

    if (productsToRender.length === 0 && !append) {
      document.getElementById('no-results').classList.remove('hidden');
      return;
    } else {
      document.getElementById('no-results').classList.add('hidden');
    }

    productsToRender.forEach(product => {
      const card = this.createProductCard(product);
      grid.appendChild(card);
    });

    this.hasMoreProducts = endIndex < this.filteredProducts.length;
    this.updateLoadMoreButton();
  }

  createProductCard(product) {
    const card = document.createElement('div');
    card.className = 'product-card bg-white rounded-2xl overflow-hidden relative group';
    
    const priceFormatted = this.formatMoney(product.price);
    const compareAtPriceFormatted = product.compareAtPrice ? this.formatMoney(product.compareAtPrice) : null;

    card.innerHTML = `
      <div class="relative overflow-hidden aspect-square bg-gray-100">
        ${product.image ? `
          <img src="${product.image}" alt="${product.title}" class="w-full h-full object-cover" loading="lazy">
        ` : `
          <div class="w-full h-full flex items-center justify-center" style="background-color: #E5E7EB;">
            <i class="ph ph-image text-6xl" style="color: #7D8A94;"></i>
          </div>
        `}
        
        ${!product.available ? `
          <div class="absolute top-2 left-2 px-3 py-1 rounded-full text-xs font-medium" style="background-color: #7D8A94; color: #FFFFFF;">
            Out of Stock
          </div>
        ` : ''}
        
        ${product.compareAtPrice ? `
          <div class="absolute top-2 right-2 px-3 py-1 rounded-full text-xs font-bold" style="background-color: #0D1B2A; color: #FFFFFF;">
            SALE
          </div>
        ` : ''}

        ${this.enableQuickView ? `
          <button class="quick-view-btn absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 p-3 rounded-full" style="background-color: #FFFFFF;" data-product-id="${product.id}">
            <i class="ph ph-eye text-xl" style="color: #0D1B2A;"></i>
          </button>
        ` : ''}
      </div>

      <div class="p-4">
        <p class="text-xs mb-1" style="color: #7D8A94;">${product.vendor || 'Soltex'}</p>
        <h3 class="font-semibold mb-2 line-clamp-2" style="color: #0D1B2A;">
          <a href="${product.url}" class="hover:underline">${product.title}</a>
        </h3>
        
        <div class="flex items-center gap-2 mb-3">
          ${compareAtPriceFormatted ? `
            <span class="text-sm line-through" style="color: #7D8A94;">${compareAtPriceFormatted}</span>
          ` : ''}
          <span class="font-bold" style="color: #0D1B2A;">${priceFormatted}</span>
        </div>

        ${this.enableQuickAdd && product.available ? `
          <button class="quick-add-btn w-full py-2 rounded-lg text-sm font-medium transition-all hover:opacity-90" style="background-color: #0D1B2A; color: #FFFFFF;" data-product-id="${product.id}" data-variant-id="${product.variants[0].id}">
            <i class="ph ph-shopping-cart"></i>
            Quick Add
          </button>
        ` : ''}
      </div>
    `;

    return card;
  }

  populateFilterOptions() {
    // Populate brand filters
    const brands = [...new Set(this.allProducts.map(p => p.vendor).filter(Boolean))];
    const brandContainer = document.getElementById('brand-filters');
    if (brandContainer) {
      brandContainer.innerHTML = brands.map(brand => `
        <label class="flex items-center cursor-pointer">
          <input type="checkbox" class="filter-checkbox hidden" name="brand" value="${brand}">
          <span class="flex items-center gap-2 px-3 py-2 rounded-lg border transition-all w-full" style="border-color: #E5E7EB; color: #0D1B2A;">
            <span class="text-sm">${brand}</span>
          </span>
        </label>
      `).join('');
    }

    // Populate type filters
    const types = [...new Set(this.allProducts.map(p => p.type).filter(Boolean))];
    const typeContainer = document.getElementById('type-filters');
    if (typeContainer) {
      typeContainer.innerHTML = types.map(type => `
        <label class="flex items-center cursor-pointer">
          <input type="checkbox" class="filter-checkbox hidden" name="type" value="${type}">
          <span class="flex items-center gap-2 px-3 py-2 rounded-lg border transition-all w-full" style="border-color: #E5E7EB; color: #0D1B2A;">
            <span class="text-sm">${type}</span>
          </span>
        </label>
      `).join('');
    }
  }

  setupEventListeners() {
    // Sort
    document.getElementById('sort-select')?.addEventListener('change', (e) => {
      this.filters.sort = e.target.value;
      this.applyFilters();
    });

    // Price filter
    document.getElementById('apply-price-filter')?.addEventListener('click', () => {
      const min = document.getElementById('price-min').value;
      const max = document.getElementById('price-max').value;
      this.filters.priceMin = min ? parseFloat(min) : null;
      this.filters.priceMax = max ? parseFloat(max) : null;
      this.applyFilters();
    });

    // Filter checkboxes (delegated)
    document.addEventListener('change', (e) => {
      if (e.target.classList.contains('filter-checkbox')) {
        const name = e.target.name;
        const value = e.target.value;
        
        if (name === 'availability') {
          if (e.target.checked) {
            this.filters.availability.push(value);
          } else {
            this.filters.availability = this.filters.availability.filter(v => v !== value);
          }
        } else if (name === 'brand') {
          if (e.target.checked) {
            this.filters.brands.push(value);
          } else {
            this.filters.brands = this.filters.brands.filter(v => v !== value);
          }
        } else if (name === 'type') {
          if (e.target.checked) {
            this.filters.types.push(value);
          } else {
            this.filters.types = this.filters.types.filter(v => v !== value);
          }
        }
        
        this.applyFilters();
      }
    });

    // Clear all filters
    document.getElementById('clear-all-filters')?.addEventListener('click', () => {
      this.resetFilters();
    });

    document.getElementById('reset-filters-btn')?.addEventListener('click', () => {
      this.resetFilters();
    });

    // Mobile filter toggle
    document.getElementById('mobile-filter-toggle')?.addEventListener('click', () => {
      document.getElementById('filters-sidebar').classList.add('active');
    });

    document.getElementById('close-filters')?.addEventListener('click', () => {
      document.getElementById('filters-sidebar').classList.remove('active');
    });

    // Quick view (delegated)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.quick-view-btn');
      if (btn) {
        const productId = btn.dataset.productId;
        this.openQuickView(productId);
      }
    });

    // Quick add (delegated)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.quick-add-btn');
      if (btn && !btn.disabled) {
        const variantId = btn.dataset.variantId;
        this.quickAddToCart(variantId, btn);
      }
    });

    // Modal close
    document.getElementById('close-modal')?.addEventListener('click', () => {
      this.closeQuickView();
    });

    document.getElementById('quick-view-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'quick-view-modal') {
        this.closeQuickView();
      }
    });

    // Load more
    document.getElementById('load-more-btn')?.addEventListener('click', () => {
      this.loadMore();
    });
  }

  setupInfiniteScroll() {
    if (!this.enableInfiniteScroll) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !this.isLoading && this.hasMoreProducts) {
          this.loadMore();
        }
      });
    }, {
      rootMargin: '200px'
    });

    const sentinel = document.createElement('div');
    sentinel.id = 'scroll-sentinel';
    document.getElementById('products-grid').parentElement.appendChild(sentinel);
    observer.observe(sentinel);
  }

  loadMore() {
    if (this.isLoading || !this.hasMoreProducts) return;
    
    this.currentPage++;
    this.renderProducts(true);
  }

  async openQuickView(productId) {
    const product = this.allProducts.find(p => p.id == productId);
    if (!product) return;

    const modal = document.getElementById('quick-view-modal');
    const content = document.getElementById('modal-content');

    content.innerHTML = `
      <div class="grid md:grid-cols-2 gap-6">
        <div class="aspect-square bg-gray-100 rounded-xl overflow-hidden">
          ${product.image ? `
            <img src="${product.image}" alt="${product.title}" class="w-full h-full object-cover">
          ` : `
            <div class="w-full h-full flex items-center justify-center" style="background-color: #E5E7EB;">
              <i class="ph ph-image text-6xl" style="color: #7D8A94;"></i>
            </div>
          `}
        </div>

        <div>
          <p class="text-sm mb-2" style="color: #7D8A94;">${product.vendor || 'Soltex'}</p>
          <h2 class="text-2xl font-bold mb-4" style="color: #0D1B2A;">${product.title}</h2>
          
          <div class="flex items-center gap-3 mb-4">
            ${product.compareAtPrice ? `
              <span class="text-lg line-through" style="color: #7D8A94;">${this.formatMoney(product.compareAtPrice)}</span>
            ` : ''}
            <span class="text-2xl font-bold" style="color: #0D1B2A;">${this.formatMoney(product.price)}</span>
          </div>

          <div class="mb-4 p-3 rounded-lg" style="background-color: #E5E7EB;">
            <div class="flex items-center gap-2">
              <i class="ph ${product.available ? 'ph-check-circle' : 'ph-x-circle'}" style="color: ${product.available ? '#10B981' : '#EF4444'};"></i>
              <span class="text-sm font-medium" style="color: #0D1B2A;">
                ${product.available ? 'In Stock' : 'Out of Stock'}
              </span>
            </div>
          </div>

          ${product.available ? `
            <button class="w-full py-3 rounded-lg font-medium mb-3 transition-all hover:opacity-90" style="background-color: #0D1B2A; color: #FFFFFF;" onclick="soltexGrid.addToCartFromModal('${product.variants[0].id}', this)">
              <i class="ph ph-shopping-cart"></i>
              Add to Cart
            </button>
          ` : ''}

          <a href="${product.url}" class="block w-full py-3 rounded-lg font-medium text-center border transition-all hover:bg-gray-50" style="border-color: #0D1B2A; color: #0D1B2A;">
            View Full Details
          </a>
        </div>
      </div>
    `;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  closeQuickView() {
    const modal = document.getElementById('quick-view-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  async quickAddToCart(variantId, button) {
    button.disabled = true;
    button.innerHTML = '<i class="ph ph-circle-notch animate-spin"></i> Adding...';

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      });

      if (response.ok) {
        this.showToast('Product added to cart!', 'success');
        button.innerHTML = '<i class="ph ph-check"></i> Added!';
        setTimeout(() => {
          button.disabled = false;
          button.innerHTML = '<i class="ph ph-shopping-cart"></i> Quick Add';
        }, 2000);
      } else {
        throw new Error('Failed to add to cart');
      }
    } catch (error) {
      this.showToast('Error adding to cart', 'error');
      button.disabled = false;
      button.innerHTML = '<i class="ph ph-shopping-cart"></i> Quick Add';
    }
  }

  async addToCartFromModal(variantId, button) {
    await this.quickAddToCart(variantId, button);
  }

  showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = `toast px-6 py-3 rounded-lg shadow-lg flex items-center gap-3 ${type === 'success' ? 'bg-green-500' : 'bg-red-500'} text-white`;
    toast.innerHTML = `
      <i class="ph ${type === 'success' ? 'ph-check-circle' : 'ph-warning-circle'} text-xl"></i>
      <span>${message}</span>
    `;
    container.appendChild(toast);

    setTimeout(() => {
      toast.remove();
    }, 3000);
  }

  updateResultsCount() {
    const count = document.getElementById('results-count');
    const total = this.filteredProducts.length;
    count.textContent = `Showing ${total} product${total !== 1 ? 's' : ''}`;
  }

  updateActiveFilters() {
    const container = document.getElementById('active-filters');
    const tagsContainer = document.getElementById('filter-tags');
    const tags = [];

    // Availability tags
    this.filters.availability.forEach(val => {
      tags.push({ type: 'availability', value: val, label: val === 'in-stock' ? 'In Stock' : 'Out of Stock' });
    });

    // Price tags
    if (this.filters.priceMin !== null || this.filters.priceMax !== null) {
      const min = this.filters.priceMin || 0;
      const max = this.filters.priceMax || '∞';
      tags.push({ type: 'price', value: 'price', label: `$${min} - $${max}` });
    }

    // Brand tags
    this.filters.brands.forEach(brand => {
      tags.push({ type: 'brand', value: brand, label: brand });
    });

    // Type tags
    this.filters.types.forEach(type => {
      tags.push({ type: 'type', value: type, label: type });
    });

    if (tags.length > 0) {
      container.classList.remove('hidden');
      tagsContainer.innerHTML = tags.map(tag => `
        <button class="filter-tag flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium" style="background-color: #0D1B2A; color: #FFFFFF;" data-filter-type="${tag.type}" data-filter-value="${tag.value}">
          <span>${tag.label}</span>
          <i class="ph ph-x"></i>
        </button>
      `).join('');

      // Add event listeners to remove tags
      tagsContainer.querySelectorAll('.filter-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const type = tag.dataset.filterType;
          const value = tag.dataset.filterValue;
          this.removeFilter(type, value);
        });
      });
    } else {
      container.classList.add('hidden');
    }
  }

  removeFilter(type, value) {
    if (type === 'availability') {
      this.filters.availability = this.filters.availability.filter(v => v !== value);
      const checkbox = document.querySelector(`input[name="availability"][value="${value}"]`);
      if (checkbox) checkbox.checked = false;
    } else if (type === 'price') {
      this.filters.priceMin = null;
      this.filters.priceMax = null;
      document.getElementById('price-min').value = '';
      document.getElementById('price-max').value = '';
    } else if (type === 'brand') {
      this.filters.brands = this.filters.brands.filter(v => v !== value);
      const checkbox = document.querySelector(`input[name="brand"][value="${value}"]`);
      if (checkbox) checkbox.checked = false;
    } else if (type === 'type') {
      this.filters.types = this.filters.types.filter(v => v !== value);
      const checkbox = document.querySelector(`input[name="type"][value="${value}"]`);
      if (checkbox) checkbox.checked = false;
    }
    this.applyFilters();
  }

  resetFilters() {
    this.filters = {
      sort: '',
      availability: [],
      priceMin: null,
      priceMax: null,
      brands: [],
      types: []
    };

    document.getElementById('sort-select').value = '';
    document.getElementById('price-min').value = '';
    document.getElementById('price-max').value = '';
    document.querySelectorAll('.filter-checkbox').forEach(cb => cb.checked = false);

    this.applyFilters();
  }

  updateLoadMoreButton() {
    const container = document.getElementById('load-more-container');
    if (!container) return;

    if (this.hasMoreProducts) {
      container.classList.remove('hidden');
    } else {
      container.classList.add('hidden');
    }
  }

  updateURL() {
    const params = new URLSearchParams();
    
    if (this.filters.sort) params.set('sort', this.filters.sort);
    if (this.filters.availability.length) params.set('availability', this.filters.availability.join(','));
    if (this.filters.priceMin) params.set('price_min', this.filters.priceMin);
    if (this.filters.priceMax) params.set('price_max', this.filters.priceMax);
    if (this.filters.brands.length) params.set('brands', this.filters.brands.join(','));
    if (this.filters.types.length) params.set('types', this.filters.types.join(','));

    const newURL = `${window.location.pathname}${params.toString() ? '?' + params.toString() : ''}`;
    window.history.replaceState({}, '', newURL);
  }

  loadFiltersFromURL() {
    const params = new URLSearchParams(window.location.search);
    
    if (params.has('sort')) {
      this.filters.sort = params.get('sort');
      document.getElementById('sort-select').value = this.filters.sort;
    }
    
    if (params.has('availability')) {
      this.filters.availability = params.get('availability').split(',');
    }
    
    if (params.has('price_min')) {
      this.filters.priceMin = parseFloat(params.get('price_min'));
      document.getElementById('price-min').value = this.filters.priceMin;
    }
    
    if (params.has('price_max')) {
      this.filters.priceMax = parseFloat(params.get('price_max'));
      document.getElementById('price-max').value = this.filters.priceMax;
    }
    
    if (params.has('brands')) {
      this.filters.brands = params.get('brands').split(',');
    }
    
    if (params.has('types')) {
      this.filters.types = params.get('types').split(',');
    }
  }

  showLoading() {
    document.getElementById('loading-indicator')?.classList.remove('hidden');
  }

  hideLoading() {
    document.getElementById('loading-indicator')?.classList.add('hidden');
  }

  showError() {
    const grid = document.getElementById('products-grid');
    grid.innerHTML = `
      <div class="col-span-full text-center py-12">
        <i class="ph ph-warning text-6xl mb-4" style="color: #EF4444;"></i>
        <h3 class="text-xl font-semibold mb-2" style="color: #0D1B2A;">Error loading products</h3>
        <p class="text-sm" style="color: #7D8A94;">Please try refreshing the page</p>
      </div>
    `;
  }

  formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }
}

// Initialize
let soltexGrid;
document.addEventListener('DOMContentLoaded', () => {
  soltexGrid = new SoltexMarketGrid();
});
</script>

