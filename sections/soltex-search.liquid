<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web/src/regular/style.css" />

<style>
  .shopdev .soltex-search {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background-color: #F9FAFB;
    min-height: 600px;
  }

  .shopdev .soltex-search__heading {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #0D1B2A;
  }

  .shopdev .soltex-search__input {
    border: 2px solid #E5E7EB;
    border-radius: 8px;
    padding: 16px 48px 16px 20px;
    font-size: 16px;
    transition: all 0.3s ease;
    background-color: #FFFFFF;
    color: #0D1B2A;
  }

  .shopdev .soltex-search__input:focus {
    outline: none;
    border-color: #0D1B2A;
    box-shadow: 0 0 0 3px rgba(13, 27, 42, 0.1);
  }

  .shopdev .soltex-search__input::placeholder {
    color: #7D8A94;
  }

  .shopdev .soltex-search__button {
    background-color: #0D1B2A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shopdev .soltex-search__button:hover {
    background-color: #1a2f47;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(13, 27, 42, 0.2);
  }

  .shopdev .soltex-search__filters {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .shopdev .soltex-search__filter-chip {
    padding: 8px 20px;
    border-radius: 24px;
    border: 2px solid #E5E7EB;
    background-color: #FFFFFF;
    color: #0D1B2A;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shopdev .soltex-search__filter-chip:hover {
    border-color: #0D1B2A;
    background-color: #F9FAFB;
  }

  .shopdev .soltex-search__filter-chip--active {
    background-color: #0D1B2A;
    color: #FFFFFF;
    border-color: #0D1B2A;
  }

  .shopdev .soltex-search__results-count {
    color: #7D8A94;
    font-size: 16px;
  }

  .shopdev .soltex-search__results-count strong {
    color: #0D1B2A;
    font-weight: 600;
  }

  .shopdev .soltex-search__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (min-width: 768px) {
    .shopdev .soltex-search__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .shopdev .soltex-search__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .shopdev .soltex-search__card {
    background-color: #FFFFFF;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(13, 27, 42, 0.08);
    transition: all 0.3s ease;
    position: relative;
  }

  .shopdev .soltex-search__card:hover {
    box-shadow: 0 8px 24px rgba(13, 27, 42, 0.15);
    transform: translateY(-4px);
  }

  .shopdev .soltex-search__card-image-wrapper {
    position: relative;
    padding-top: 100%;
    background-color: #F9FAFB;
    overflow: hidden;
  }

  .shopdev .soltex-search__card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .shopdev .soltex-search__card:hover .soltex-search__card-image {
    transform: scale(1.05);
  }

  .shopdev .soltex-search__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .shopdev .soltex-search__badge--sale {
    background-color: #DC2626;
    color: #FFFFFF;
  }

  .shopdev .soltex-search__badge--sold-out {
    background-color: #7D8A94;
    color: #FFFFFF;
  }

  .shopdev .soltex-search__card-content {
    padding: 16px;
  }

  .shopdev .soltex-search__vendor {
    color: #7D8A94;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .shopdev .soltex-search__title {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #0D1B2A;
    margin-bottom: 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .shopdev .soltex-search__sku {
    color: #7D8A94;
    font-size: 13px;
    margin-bottom: 12px;
    font-family: 'Courier New', monospace;
  }

  .shopdev .soltex-search__price-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .shopdev .soltex-search__price {
    font-size: 18px;
    font-weight: 700;
    color: #0D1B2A;
  }

  .shopdev .soltex-search__price--compare {
    font-size: 16px;
    color: #7D8A94;
    text-decoration: line-through;
    font-weight: 400;
  }

  .shopdev .soltex-search__availability {
    font-size: 13px;
    margin-bottom: 12px;
    font-weight: 500;
  }

  .shopdev .soltex-search__availability--in-stock {
    color: #059669;
  }

  .shopdev .soltex-search__availability--out-of-stock {
    color: #DC2626;
  }

  .shopdev .soltex-search__actions {
    display: flex;
    gap: 8px;
  }

  .shopdev .soltex-search__quick-add {
    flex: 1;
    background-color: #0D1B2A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .shopdev .soltex-search__quick-add:hover:not(:disabled) {
    background-color: #1a2f47;
  }

  .shopdev .soltex-search__quick-add:disabled {
    background-color: #E5E7EB;
    color: #7D8A94;
    cursor: not-allowed;
  }

  .shopdev .soltex-search__view-details {
    background-color: transparent;
    color: #0D1B2A;
    border: 2px solid #0D1B2A;
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shopdev .soltex-search__view-details:hover {
    background-color: #0D1B2A;
    color: #FFFFFF;
  }

  .shopdev .soltex-search__empty {
    text-align: center;
    padding: 80px 20px;
  }

  .shopdev .soltex-search__empty-icon {
    font-size: 64px;
    color: #E5E7EB;
    margin-bottom: 24px;
  }

  .shopdev .soltex-search__empty-title {
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #0D1B2A;
    margin-bottom: 12px;
  }

  .shopdev .soltex-search__empty-text {
    color: #7D8A94;
    font-size: 16px;
    margin-bottom: 24px;
  }

  .shopdev .soltex-search__pagination {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  .shopdev .soltex-search__load-more {
    background-color: #FFFFFF;
    color: #0D1B2A;
    border: 2px solid #0D1B2A;
    border-radius: 8px;
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shopdev .soltex-search__load-more:hover {
    background-color: #0D1B2A;
    color: #FFFFFF;
  }

  .shopdev .soltex-search__spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #FFFFFF;
    animation: shopdev-spin 0.8s linear infinite;
  }

  @keyframes shopdev-spin {
    to { transform: rotate(360deg); }
  }

  .shopdev .soltex-search__loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(249, 250, 251, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .shopdev .soltex-search__loading-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid #E5E7EB;
    border-radius: 50%;
    border-top-color: #0D1B2A;
    animation: shopdev-spin 0.8s linear infinite;
  }
</style>

<div class="soltex-search w-full py-12 px-4 md:px-8">
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Search Bar -->
    <div class="mb-8">
      <div class="max-w-3xl mx-auto relative">
        <form action="/search" method="get" role="search">
          <input 
            type="search" 
            name="q" 
            class="soltex-search__input w-full"
            placeholder="{{ section.settings.search_placeholder }}"
            value="{{ search.terms }}"
            autocomplete="off"
          >
          <input type="hidden" name="type" value="product">
          <button type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#7D8A94] hover:text-[#0D1B2A] transition-colors">
            <i class="ph ph-magnifying-glass text-[24px]"></i>
          </button>
        </form>
      </div>
    </div>

    {% if search.performed %}
      
      <!-- Results Header -->
      <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="soltex-search__results-count">
          {% if search.results_count > 0 %}
            Mostrando <strong>{{ search.results_count }}</strong> resultado{% if search.results_count != 1 %}s{% endif %} para "<strong>{{ search.terms }}</strong>"
          {% else %}
            No se encontraron resultados para "<strong>{{ search.terms }}</strong>"
          {% endif %}
        </div>

        {% if search.results_count > 0 %}
          <div class="soltex-search__filters" data-filters>
            <button class="soltex-search__filter-chip soltex-search__filter-chip--active" data-filter="all">
              Todo
            </button>
            <button class="soltex-search__filter-chip" data-filter="available">
              Disponible
            </button>
            <button class="soltex-search__filter-chip" data-filter="sold-out">
              Agotado
            </button>
          </div>
        {% endif %}
      </div>

      {% if search.results_count > 0 %}
        
        <!-- Products Grid -->
        <div class="relative" data-search-container>
          <div class="soltex-search__grid" data-products-grid>
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% assign product = item %}
                {% assign on_sale = false %}
                {% if product.compare_at_price > product.price %}
                  {% assign on_sale = true %}
                {% endif %}
                
                <div class="soltex-search__card" data-product-card data-availability="{% if product.available %}available{% else %}sold-out{% endif %}">
                  <a href="{{ product.url }}" class="block">
                    <div class="soltex-search__card-image-wrapper">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 600 | image_tag: 
                          class: 'soltex-search__card-image',
                          loading: 'lazy',
                          alt: product.title
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'soltex-search__card-image' }}
                      {% endif %}

                      {% if on_sale %}
                        <span class="soltex-search__badge soltex-search__badge--sale">Oferta</span>
                      {% elsif product.available == false %}
                        <span class="soltex-search__badge soltex-search__badge--sold-out">Agotado</span>
                      {% endif %}
                    </div>
                  </a>

                  <div class="soltex-search__card-content">
                    {% if product.vendor != blank %}
                      <div class="soltex-search__vendor">{{ product.vendor }}</div>
                    {% endif %}

                    <a href="{{ product.url }}" class="soltex-search__title">
                      {{ product.title }}
                    </a>

                    {% if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank %}
                      <div class="soltex-search__sku">
                        SKU: {{ product.selected_or_first_available_variant.sku }}
                      </div>
                    {% endif %}

                    <div class="soltex-search__price-wrapper">
                      <span class="soltex-search__price">{{ product.price | money }}</span>
                      {% if on_sale %}
                        <span class="soltex-search__price--compare">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>

                    <div class="soltex-search__availability {% if product.available %}soltex-search__availability--in-stock{% else %}soltex-search__availability--out-of-stock{% endif %}">
                      {% if product.available %}
                        <i class="ph ph-check-circle"></i> Disponible
                      {% else %}
                        <i class="ph ph-x-circle"></i> Agotado
                      {% endif %}
                    </div>

                    <div class="soltex-search__actions">
                      {% if section.settings.show_quick_add %}
                        <button 
                          class="soltex-search__quick-add" 
                          data-quick-add
                          data-product-id="{{ product.selected_or_first_available_variant.id }}"
                          {% unless product.available %}disabled{% endunless %}
                        >
                          <i class="ph ph-shopping-cart"></i>
                          {% if product.available %}Agregar{% else %}Agotado{% endif %}
                        </button>
                      {% endif %}
                      <a href="{{ product.url }}" class="soltex-search__view-details">
                        <i class="ph ph-eye"></i>
                      </a>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Loading Overlay -->
          <div class="soltex-search__loading-overlay" data-loading-overlay style="display: none;">
            <div class="soltex-search__loading-spinner"></div>
          </div>
        </div>

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="soltex-search__pagination">
            {% if paginate.next %}
              <button class="soltex-search__load-more" data-load-more data-next-url="{{ paginate.next.url }}">
                Cargar más productos
              </button>
            {% endif %}
          </div>
        {% endif %}

      {% else %}
        
        <!-- Empty State -->
        <div class="soltex-search__empty">
          <div class="soltex-search__empty-icon">
            <i class="ph ph-magnifying-glass"></i>
          </div>
          <h3 class="soltex-search__empty-title">No encontramos resultados</h3>
          <p class="soltex-search__empty-text">
            Intenta con otros términos de búsqueda o explora nuestro catálogo completo
          </p>
          <a href="/collections/all" class="soltex-search__button">
            Ver todos los productos
          </a>
        </div>

      {% endif %}

    {% else %}
      
      <!-- Initial State -->
      <div class="soltex-search__empty">
        <div class="soltex-search__empty-icon">
          <i class="ph ph-magnifying-glass"></i>
        </div>
        <h3 class="soltex-search__empty-title">Busca productos por modelo, SKU o marca</h3>
        <p class="soltex-search__empty-text">
          Utiliza la barra de búsqueda para encontrar exactamente lo que necesitas
        </p>
      </div>

    {% endif %}

  </div>
</div>

<script>
  class SoltexSearch {
    constructor() {
      this.filterButtons = document.querySelectorAll('[data-filter]');
      this.productCards = document.querySelectorAll('[data-product-card]');
      this.quickAddButtons = document.querySelectorAll('[data-quick-add]');
      this.loadMoreButton = document.querySelector('[data-load-more]');
      this.productsGrid = document.querySelector('[data-products-grid]');
      this.loadingOverlay = document.querySelector('[data-loading-overlay]');
      this.searchContainer = document.querySelector('[data-search-container]');
      
      this.init();
    }

    init() {
      this.setupFilters();
      this.setupQuickAdd();
      this.setupLoadMore();
      this.setupInfiniteScroll();
    }

    setupFilters() {
      this.filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const filter = e.currentTarget.dataset.filter;
          
          // Update active state
          this.filterButtons.forEach(btn => btn.classList.remove('soltex-search__filter-chip--active'));
          e.currentTarget.classList.add('soltex-search__filter-chip--active');
          
          // Filter products
          this.filterProducts(filter);
        });
      });
    }

    filterProducts(filter) {
      this.productCards.forEach(card => {
        const availability = card.dataset.availability;
        
        if (filter === 'all') {
          card.style.display = 'block';
        } else if (filter === 'available' && availability === 'available') {
          card.style.display = 'block';
        } else if (filter === 'sold-out' && availability === 'sold-out') {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    setupQuickAdd() {
      this.quickAddButtons.forEach(button => {
        button.addEventListener('click', async (e) => {
          e.preventDefault();
          const variantId = e.currentTarget.dataset.productId;
          const originalText = e.currentTarget.innerHTML;
          
          // Show loading state
          e.currentTarget.innerHTML = '<span class="soltex-search__spinner"></span>';
          e.currentTarget.disabled = true;
          
          try {
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 1
              })
            });
            
            if (response.ok) {
              // Success feedback
              e.currentTarget.innerHTML = '<i class="ph ph-check"></i> Agregado';
              
              // Trigger cart update event
              document.dispatchEvent(new CustomEvent('cart:updated'));
              
              // Reset button after 2 seconds
              setTimeout(() => {
                e.currentTarget.innerHTML = originalText;
                e.currentTarget.disabled = false;
              }, 2000);
            } else {
              throw new Error('Error al agregar al carrito');
            }
          } catch (error) {
            console.error('Error:', error);
            e.currentTarget.innerHTML = '<i class="ph ph-warning"></i> Error';
            setTimeout(() => {
              e.currentTarget.innerHTML = originalText;
              e.currentTarget.disabled = false;
            }, 2000);
          }
        });
      });
    }

    setupLoadMore() {
      if (!this.loadMoreButton) return;
      
      this.loadMoreButton.addEventListener('click', async (e) => {
        e.preventDefault();
        const nextUrl = e.currentTarget.dataset.nextUrl;
        
        if (!nextUrl) return;
        
        // Show loading state
        const originalText = e.currentTarget.textContent;
        e.currentTarget.innerHTML = '<span class="soltex-search__spinner"></span> Cargando...';
        e.currentTarget.disabled = true;
        
        try {
          const response = await fetch(nextUrl);
          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          
          // Get new products
          const newProducts = doc.querySelectorAll('[data-product-card]');
          newProducts.forEach(product => {
            this.productsGrid.appendChild(product.cloneNode(true));
          });
          
          // Update load more button
          const newLoadMoreButton = doc.querySelector('[data-load-more]');
          if (newLoadMoreButton) {
            this.loadMoreButton.dataset.nextUrl = newLoadMoreButton.dataset.nextUrl;
            this.loadMoreButton.textContent = originalText;
            this.loadMoreButton.disabled = false;
          } else {
            this.loadMoreButton.remove();
          }
          
          // Reinitialize quick add for new products
          this.quickAddButtons = document.querySelectorAll('[data-quick-add]');
          this.setupQuickAdd();
          
        } catch (error) {
          console.error('Error loading more products:', error);
          e.currentTarget.textContent = 'Error al cargar';
          setTimeout(() => {
            e.currentTarget.textContent = originalText;
            e.currentTarget.disabled = false;
          }, 2000);
        }
      });
    }

    setupInfiniteScroll() {
      if (!{{ section.settings.enable_infinite_scroll | json }} || !this.loadMoreButton) return;
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !this.loadMoreButton.disabled) {
            this.loadMoreButton.click();
          }
        });
      }, {
        rootMargin: '200px'
      });
      
      observer.observe(this.loadMoreButton);
    }
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new SoltexSearch();
    });
  } else {
    new SoltexSearch();
  }
</script>

{% schema %}
{
  "name": "soltex-search",
  "class": "shopdev",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Configuración de Búsqueda"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder de búsqueda",
      "default": "Buscar por modelo, SKU o marca…"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 12,
      "max": 96,
      "step": 12,
      "label": "Resultados por página",
      "default": 24
    },
    {
      "type": "header",
      "content": "Opciones de Visualización"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Mostrar SKU",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar botón Quick Add",
      "default": true
    },
    {
      "type": "header",
      "content": "Paginación"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "Activar scroll infinito",
      "default": false,
      "info": "Los productos se cargarán automáticamente al hacer scroll"
    }
  ],
  "presets": [
    {
      "name": "soltex-search",
      "settings": {
        "search_placeholder": "Buscar por modelo, SKU o marca…",
        "results_per_page": 24,
        "show_sku": true,
        "show_quick_add": true,
        "enable_infinite_scroll": false
      }
    }
  ]
}
{% endschema %}