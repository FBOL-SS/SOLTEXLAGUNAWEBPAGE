<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap">

<style>
  /* === TU CSS ORIGINAL (sin cambios) === */
  .shopdev .featured-categories-section { font-family: 'Inter', sans-serif; padding: 60px 20px; background-color: #ffffff; }
  .shopdev .section-header { text-align: center; margin-bottom: 48px; }
  .shopdev .section-title { font-family: 'Poppins', sans-serif; font-size: 36px; font-weight: 700; color: #0d1b2a; margin-bottom: 12px; }
  .shopdev .section-subtitle { font-size: 16px; color: #6b7280; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .shopdev .categories-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 1200px; margin: 0 auto; }
  @media (min-width: 768px) { .shopdev .categories-grid { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  @media (min-width: 1024px) { .shopdev .categories-grid { grid-template-columns: repeat(4, 1fr); } }
  .shopdev .category-card { position: relative; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 12px rgba(13, 27, 42, 0.08); overflow: hidden; transition: all 0.3s ease; display: block; text-decoration: none; }
  .shopdev .category-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(13, 27, 42, 0.15); }
  .shopdev .category-image-wrapper { position: relative; width: 100%; padding-bottom: 80%; overflow: hidden; background-color: #f4f4f4; display: flex; align-items: center; justify-content: center; }
  .shopdev .category-image { position: absolute; width: 70% !important; height: 70% !important; left: 50%; top: 50%; transform: translate(-50%, -50%); object-fit: contain; transition: transform 0.5s ease; }
  .shopdev .category-card:hover .category-image { transform: translate(-50%, -50%) scale(1.1); }
  .shopdev .category-content { padding: 20px; }
  .shopdev .category-title { font-family: 'Poppins', sans-serif; font-size: 18px; font-weight: 700; color: #0d1b2a; margin-bottom: 8px; line-height: 1.3; }
  .shopdev .category-description { font-size: 14px; color: #6b7280; line-height: 1.5; margin: 0; }
  @keyframes shopdev-fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .shopdev .category-card { animation: shopdev-fadeUp 0.6s ease-out forwards; opacity: 0; }
  .shopdev .category-card:nth-child(1) { animation-delay: 0.1s; }
  .shopdev .category-card:nth-child(2) { animation-delay: 0.2s; }
  .shopdev .category-card:nth-child(3) { animation-delay: 0.3s; }
  .shopdev .category-card:nth-child(4) { animation-delay: 0.4s; }
  .shopdev .category-card:nth-child(5) { animation-delay: 0.5s; }
  .shopdev .category-card:nth-child(6) { animation-delay: 0.6s; }
  .shopdev .category-card:nth-child(7) { animation-delay: 0.7s; }
  .shopdev .category-card:nth-child(8) { animation-delay: 0.8s; }
  @media (max-width: 767px) {
    .shopdev .section-title { font-size: 28px; }
    .shopdev .section-subtitle { font-size: 14px; }
    .shopdev .featured-categories-section { padding: 40px 16px; }
    .shopdev .category-title { font-size: 16px; }
    .shopdev .category-description { font-size: 13px; }
    .shopdev .category-content { padding: 16px; }
    .shopdev .category-image { width: 60% !important; height: 60% !important; }
  }
</style>

<div class="w-full">
  <div class="featured-categories-section">
    {% if section.settings.section_title != blank or section.settings.section_subtitle != blank %}
      <div class="section-header">
        {% if section.settings.section_title != blank %}
          <h2 class="section-title">{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_subtitle != blank %}
          <p class="section-subtitle">{{ section.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="categories-grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.category_url | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
            <div class="category-image-wrapper">
              {%- if block.settings.category_image != blank -%}
                {{ block.settings.category_image | image_url: width: 600 | image_tag: 
                  class: 'category-image',
                  loading: 'lazy',
                  alt: block.settings.category_name
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'category-image' }}
              {%- endif -%}
            </div>
            <div class="category-content">
              {% if block.settings.category_name != blank %}
                <h3 class="category-title">{{ block.settings.category_name }}</h3>
              {% endif %}
              {% if block.settings.category_description != blank %}
                <p class="category-description">{{ block.settings.category_description }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div style="text-align: center; padding: 60px 20px; color: #6b7280;">
        <p>Add category blocks to display your featured categories</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "soltex-featured-categorie",
  "class": "shopdev",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Categorías destacadas"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Explore our comprehensive range of industrial machinery and parts"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "category_image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "category_name",
          "label": "Category Name",
          "default": "Category Name"
        },
        {
          "type": "textarea",
          "id": "category_description",
          "label": "Category Description",
          "default": "Brief description of this category"
        },
        {
          "type": "url",
          "id": "category_url",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "soltex-featured-categories",
      "settings": {
        "section_title": "Categorías destacadas",
        "section_subtitle": "Descubre nuestra amplia gama de maquinaria industrial y componentes de alta calidad"
      },
      "blocks": [
        { "type": "category", "settings": { "category_name": "Bombas Hidráulicas", "category_description": "Bombas de alta presión...", "category_url": "/collections/activewear" } },
        { "type": "category", "settings": { "category_name": "Válvulas Industriales", "category_description": "Válvulas de control...", "category_url": "/collections/leasure" } },
        { "type": "category", "settings": { "category_name": "Motores Eléctricos", "category_description": "Motores de alto...", "category_url": "/collections/all" } },
        { "type": "category", "settings": { "category_name": "Rodamientos", "category_description": "Rodamientos de precisión...", "category_url": "/collections/activewear" } },
        { "type": "category", "settings": { "category_name": "Sistemas de Transmisión", "category_description": "Engranajes y...", "category_url": "/collections/leasure" } },
        { "type": "category", "settings": { "category_name": "Cilindros Neumáticos", "category_description": "Actuadores neumáticos...", "category_url": "/collections/all" } },
        { "type": "category", "settings": { "category_name": "Filtros Industriales", "category_description": "Sistemas de filtración...", "category_url": "/collections/activewear" } },
        { "type": "category", "settings": { "category_name": "Sellos y Juntas", "category_description": "Componentes de sellado...", "category_url": "/collections/leasure" } }
      ]
    }
  ]
}
{% endschema %}