<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>StitchWizard - Mosaico de Prendas</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f4f6f9;
      padding: 20px;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
      color: #2c3e50;
      font-size: 2rem;
    }

    /* Mosaico Grid */
    .mosaic-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 10px;
    }

    .mosaic-item {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
      background: white;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      aspect-ratio: 1 / 1; /* Cuadrado perfecto */
    }

    .mosaic-item:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    }

    .mosaic-item img {
      width: 100%;
      height: 100%;
      object-fit: cover; /* CLAVE: recorta sin deformar */
      transition: transform 0.4s ease;
    }

    .mosaic-item:hover img {
      transform: scale(1.08);
    }

    /* Etiqueta opcional */
    .mosaic-label {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.7));
      color: white;
      padding: 20px 12px 12px;
      font-size: 0.9rem;
      font-weight: 600;
      text-align: center;
    }

    /* Responsive */
    @media (max-width: 600px) {
      .mosaic-grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
      }
      h1 { font-size: 1.5rem; }
    }
  </style>
</head>
<body>

  <h1>StitchWizard - Catálogo de Prendas</h1>

  <div class="mosaic-grid">
    <!-- Repite este bloque por cada prenda -->
    <div class="mosaic-item">
      <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Zapatilla roja">
      <div class="mosaic-label">Zapatilla Urban</div>
    </div>

    <div class="mosaic-item">
      <img src="https://images.unsplash.com/photo-1551107696-a4b0c5a0d4d5?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Camiseta">
      <div class="mosaic-label">Camiseta Básica</div>
    </div>

    <div class="mosaic-item">
      <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Reloj">
      <div class="mosaic-label">Reloj Clásico</div>
    </div>

    <div class="mosaic-item">
      <img src="https://images.unsplash.com/photo-1584911846112-2e1d1e9e1d0e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Mochila">
      <div class="mosaic-label">Mochila Explorer</div>
    </div>

    <div class="mosaic-item">
      <img src="https://images.unsplash.com/photo-1560769629-975ec58e4ce8?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Gafas">
      <div class="mosaic-label">Gafas Sol</div>
    </div>

    <div class="mosaic-item">
      <img src="https://images.unsplash.com/photo-1604176354204-9268737828e4?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Sudadera">
      <div class="mosaic-label">Sudadera Gris</div>
    </div>
  </div>

</body>
</html>