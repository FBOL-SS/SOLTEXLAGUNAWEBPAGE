{% layout 'theme' %}

<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-3xl md:text-4xl font-bold text-center mb-8">Búsqueda de productos</h1>

  <!-- BUSCADOR -->
  <form action="/search" method="get" class="max-w-2xl mx-auto mb-10">
    <div class="relative">
      <input
        type="text"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Buscar productos..."
        class="w-full px-5 py-3 pr-12 text-lg border-2 border-gray-300 rounded-xl focus:outline-none focus:border-black transition-colors"
        autocomplete="off"
      >
      <button type="submit" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-black">
        Search Icon
      </button>
    </div>
  </form>

  <!-- RESULTADOS -->
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div class="text-center py-16">
        <p class="text-xl text-gray-600 mb-6">No se encontraron productos para "<strong class="text-black">{{ search.terms }}</strong>"</p>
        <a href="/collections/all" class="inline-block px-8 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition">
          Ver todos los productos
        </a>
      </div>
    {% else %}
      <div class="text-center mb-8">
        <p class="text-sm text-gray-600">
          {{ search.results_count }} producto{{ search.results_count | pluralize: '', 's' }} encontrado{{ search.results_count | pluralize: '', 's' }}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% assign product = item %}
            <a href="{{ product.url }}" class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300">
              <div class="aspect-square relative overflow-hidden bg-gray-50">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full' }}
                {% endif %}

                <!-- BADGES -->
                {% unless product.available %}
                  <span class="absolute top-3 left-3 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full">Agotado</span>
                {% else %}
                  {% if product.compare_at_price > product.price %}
                    <span class="absolute top-3 left-3 bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-full">Oferta</span>
                  {% endif %}
                {% endunless %}
              </div>

              <div class="p-5">
                <h3 class="font-medium text-gray-900 line-clamp-2 group-hover:text-black transition mb-2">
                  {{ product.title }}
                </h3>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    {% if product.compare_at_price > product.price %}
                      <span class="text-sm text-gray-500 line-through">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="text-lg font-bold text-black">{{ product.price | money }}</span>
                  </div>
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <!-- PAGINACIÓN -->
      {% if paginate.pages > 1 %}
        <div class="flex justify-center">
          {% render 'pagination', paginate: paginate %}
        </div>
      {% endif %}
    {% endif %}
  {% else %}
    <div class="text-center py-16">
      <p class="text-xl text-gray-600">Escribe algo para comenzar la búsqueda...</p>
    </div>
  {% endif %}
</div>