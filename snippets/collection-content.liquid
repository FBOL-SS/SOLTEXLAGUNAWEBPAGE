{% if section.settings.show_collection_title and collection.title %}
  <div class="px-4 md:px-8 py-8">
    <h1 class="text-3xl md:text-4xl font-bold text-center">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="text-center mt-4 text-gray-600 max-w-2xl mx-auto">{{ collection.description }}</div>
    {% endif %}
  </div>
{% endif %}

<div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-0">
  <aside class="filter-sidebar" id="filterSidebar">
    <div class="filter-sidebar-header">
      <h2 class="text-lg font-semibold">Filtros</h2>
      <button class="filter-sidebar-close" onclick="toggleMobileFilters()">X</button>
    </div>
    {% if collection.filters.size > 0 %}
      <form id="filterForm">
        {% for filter in collection.filters %}
          <div class="filter-group">
            <div class="filter-group-header"><h3>{{ filter.label }}</h3><i class="ph ph-caret-down"></i></div>
            <div class="filter-group-content">
              {% case filter.type %}
                {% when 'list' %}
                  {% for value in filter.values %}
                    <div class="filter-option {% unless value.active or value.count > 0 %}disabled{% endunless %}">
                      <input type="checkbox" id="f-{{ filter.param_name }}-{{ forloop.index }}" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="applyFilters()">
                      <label for="f-{{ filter.param_name }}-{{ forloop.index }}"><span>{{ value.label }}</span>{% if section.settings.show_product_counts %}<span class="filter-count">({{ value.count }})</span>{% endif %}</label>
                    </div>
                  {% endfor %}
                {% when 'price_range' %}
                  <div class="price-range-inputs">
                    <div class="price-input-wrapper"><label>Min</label><input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | default: filter.range_min | divided_by: 100.0 }}" min="{{ filter.range_min | divided_by: 100.0 }}" max="{{ filter.range_max | divided_by: 100.0 }}"></div>
                    <div class="price-input-wrapper"><label>Max</label><input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | default: filter.range_max | divided_by: 100.0 }}" min="{{ filter.range_min | divided_by: 100.0 }}" max="{{ filter.range_max | divided_by: 100.0 }}"></div>
                  </div>
              {% endcase %}
            </div>
          </div>
        {% endfor %}
        <div class="filter-actions" style="padding:20px;">
          <button type="button" class="filter-btn filter-btn-primary" onclick="applyFilters()">Aplicar</button>
          <button type="button" class="filter-btn" onclick="clearFilters()">Limpiar</button>
        </div>
      </form>
    {% endif %}
  </aside>

  <main class="px-4 md:px-8 py-6">
    <button class="mobile-filter-toggle" onclick="toggleMobileFilters()">Filtros y Orden</button>

    <div class="toolbar">
      <div class="product-count">{{ paginate.items }} PRODUCTOS</div>
      <div class="search-container">
        <input type="text" id="searchInput" placeholder="Buscar en esta colección..." value="{{ request.page_params.q | escape }}" oninput="debouncedSearch()" autocomplete="off">
        <i class="ph ph-magnifying-glass"></i>
        <i class="ph ph-x clear-search" id="clearSearchBtn" onclick="clearSearch()"></i>
      </div>
      <div class="sort-dropdown">
        <label>Ordenar por:</label>
        <select onchange="sortCollection(this.value)">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Destacados</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Precio: Bajo a Alto</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Precio: Alto a Bajo</option>
        </select>
      </div>
    </div>

    <div class="no-results"></div>
    <div class="product-grid">
      {% for product in current_products %}
        <!-- Product card aquí (igual que antes) -->
      {% endfor %}
    </div>

    <div class="pagination"></div>
  </main>
</div>